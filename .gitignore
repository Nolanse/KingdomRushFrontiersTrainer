# 任何从游戏安装包直接取出的可执行文件
# （不要用宽泛的 *.exe 规则，避免误伤自己构建的产物）
*Kingdom*Rush*.exe

# ============================================================
#  构建产物
# ============================================================
build/
dist/
*.spec
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ============================================================
#  运行时产物（写在本机，不应进仓库）
# ============================================================
# 界面配置与日志：实际写在 %LOCALAPPDATA%\KingdomRushFrontiersTrainer，
# 这里再兜一层，防止有人改了路径把本机状态提交上来。
config.json
*.log
trainer.log
krft_state.lua
krft_status.txt
krft_bridge.lua.bak
slot_*.lua
KRTrainerBackups/
KRFTBackups/

# ============================================================
#  敏感信息（防止误提交）
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
secrets*.json
credentials.json
*_rsa
*_ed25519
*_dsa

# ============================================================
#  编辑器与系统
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ============================================================
#  逆向分析产物（保留方法，不留数据）
# ============================================================
*.decompiled.lua
*.dump
*.strings.txt

# 逆向工作区（若有人把解包结果放在项目内）
krf_x/
krf_probe/
src_krt/
_extract/
*_decompiled.lua
